// src/api/streamApi.js
import { BASE_URL } from "./config";
import { handleResponse } from "./handleResponse";

const STREAM_URL = `${BASE_URL}/course/index.php`;

// Fetch streams by course
export async function fetchStreams(courseId) {
  if (!courseId) {
    throw new Error("Course ID is required");
  }

  const res = await fetch(`${STREAM_URL}?type=stream&course_id=${courseId}`);

  return handleResponse(res);
}

// Fetch ALL courses (no faculty filter)
export async function fetchAllCourses() {
  const res = await fetch(`${BASE_URL}/course/index.php?type=course`);

  return handleResponse(res);
}

// Create stream
export async function createStream(courseId, name) {
  const trimmed = name?.trim();

  if (!courseId) throw new Error("Course ID is required");
  if (!trimmed) throw new Error("Stream name is required");

  const res = await fetch(STREAM_URL, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      type: "stream",
      name: trimmed,
      course_id: courseId,
    }),
  });

  return handleResponse(res);
}

// Delete stream
export async function deleteStream(id) {
  if (!id) throw new Error("Stream ID is required");

  const res = await fetch(STREAM_URL, {
    method: "DELETE",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      type: "stream",
      id: String(id),
    }),
  });

  return handleResponse(res);
}
</file>

